# reporting-service local settings. Copy to .env and fill in.
# Format: KEY=VALUE, read as a Java properties file -> use forward slashes in paths, no quotes.

# Database settings (development: auth_svc owns auth_db, verifone_db, gilbarco_db)
HOR_DB_HOST=localhost
HOR_DB_PORT=5432
HOR_DB_USERNAME=auth_svc
HOR_DB_PASSWORD=

# Database names (defaults to verifone_db and gilbarco_db; or cpj_analytics and pjr_analytics for local XML prototypes)
HOR_VERIFONE_DB_NAME=verifone_db
HOR_GILBARCO_DB_NAME=gilbarco_db
HOR_AUTH_DB_NAME=auth_db

# Auth service JWKS URI for token validation
HOR_AUTH_JWKS_URI=http://127.0.0.1:8091/api/auth/.well-known/jwks.json
HOR_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
