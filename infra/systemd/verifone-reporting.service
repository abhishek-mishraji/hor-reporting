# Install: sudo cp infra/systemd/verifone-reporting.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now verifone-reporting
# Runs the jar straight from the clone; settings come from .env in WorkingDirectory.
# Needs auth-service (JWKS at 127.0.0.1:8091) and PostgreSQL.
[Unit]
Description=HOR Verifone Reporting Service
After=network-online.target postgresql.service auth-service.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/hor/store-automation/hor-reporting/verifone-reporting-service
ExecStart=/usr/bin/java -Xmx512m -jar /opt/hor/store-automation/hor-reporting/verifone-reporting-service/build/libs/verifone-reporting-service.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
